#!/usr/bin/env bash
# Cupcake Clean Session Logout Script for Hyprland + SDDM

# 1. Switch seat to SDDM VT (VT 2) immediately to hide VT 1 terminal console
gdbus call --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1/seat/seat0 --method org.freedesktop.login1.Seat.SwitchTo 2 2>/dev/null || true

# 2. Terminate background daemons
killall -9 quickshell awww-daemon mpvpaper hyprsunset hypridle cliphist wl-paste nm-applet udiskie polkit-gnome-authentication-agent-1 2>/dev/null || true
pkill -9 -f "battery-warning.sh" 2>/dev/null || true

# 3. Cleanly exit Hyprland
hyprctl dispatch exit 2>/dev/null || true
killall -9 Hyprland 2>/dev/null || true

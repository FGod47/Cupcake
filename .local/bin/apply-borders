#!/bin/bash

STATE=$(cat ~/.config/cupcake/.borders 2>/dev/null || echo "true")
SIZE=$(cat ~/.config/cupcake/.border_size 2>/dev/null || echo "3")
if [ "$STATE" = "false" ]; then
    SIZE=0
fi

# Modify decoration.lua
sed -i "s/border_size = .*,/border_size = $SIZE,/g" ~/.config/hypr/decoration.lua

# Modify custom-prefs.conf if it exists
if [ -f ~/.config/hypr/custom-prefs.conf ]; then
    sed -i "s/border_size = .*/border_size = $SIZE/g" ~/.config/hypr/custom-prefs.conf
fi

hyprctl reload

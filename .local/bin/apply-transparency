#!/bin/bash
TRANS=$(cat ~/.config/cupcake/.transparency 2>/dev/null || echo true)
BAR_TRANS=$(cat ~/.config/cupcake/.bar_transparency 2>/dev/null || echo true)
source ~/.config/cupcake/.transparency_values 2>/dev/null

OPACITY=${OPACITY:-0.90}
BLUR_SIZE=${BLUR_SIZE:-11}
BLUR_PASSES=${BLUR_PASSES:-3}
INACTIVE_OPACITY=$OPACITY

XRAY_BLUR=$(cat ~/.config/cupcake/.xray_blur 2>/dev/null || echo true)
[ -z "$XRAY_BLUR" ] && XRAY_BLUR=true

# If either window transparency OR quickshell transparency is enabled, blur MUST be enabled in Hyprland
BLUR_ENABLED=false
if [ "$TRANS" = "true" ] || [ "$BAR_TRANS" = "true" ]; then
    BLUR_ENABLED=true
fi

WIN_ACT_OP="1.0"
WIN_INACT_OP="1.0"
if [ "$TRANS" = "true" ]; then
    WIN_ACT_OP="$OPACITY"
    WIN_INACT_OP="$INACTIVE_OPACITY"
    sed -i "s/^background_opacity.*/background_opacity $OPACITY/g" ~/.config/kitty/kitty.conf 2>/dev/null || true
else
    sed -i 's/^background_opacity.*/background_opacity 1.0/g' ~/.config/kitty/kitty.conf 2>/dev/null || true
fi

cat <<EOF > ~/.config/hypr/transparency.lua
hl.config({
    decoration = {
        active_opacity = $WIN_ACT_OP,
        inactive_opacity = $WIN_INACT_OP,
        blur = {
            enabled = $BLUR_ENABLED,
            size = $BLUR_SIZE,
            passes = $BLUR_PASSES,
            xray = $XRAY_BLUR,
            popups = false,
            ignore_opacity = true
        }
    }
})
EOF

if [ "$BAR_TRANS" = "true" ]; then
    # Use a robust ignore_alpha threshold (0.05).
    # In Quickshell, transparent margins and outer bounds have alpha=0.00.
    # Setting ignore_alpha=0.05 blocks empty transparency from blurring (preventing square box bleed)
    # while allowing ANY user-chosen opacity level (0.10 to 1.00) to blur reliably without breaking.
    IGNORE_ALPHA="0.05"

    cat <<EOF >> ~/.config/hypr/transparency.lua
hl.layer_rule({ match = { namespace = 'quickshell' }, blur = true })
hl.layer_rule({ match = { namespace = 'quickshell' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'quickshell' }, xray = $XRAY_BLUR })

hl.layer_rule({ match = { namespace = 'quickshell:.*' }, blur = true })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, xray = $XRAY_BLUR })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, blur_popups = true })

hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, blur = true })
hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, xray = $XRAY_BLUR })

hl.layer_rule({ match = { namespace = 'cupcake-wallpaper' }, blur = true })
hl.layer_rule({ match = { namespace = 'cupcake-wallpaper' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'cupcake-wallpaper' }, xray = $XRAY_BLUR })

hl.layer_rule({ match = { namespace = 'cupcake-settings' }, blur = true })
hl.layer_rule({ match = { namespace = 'cupcake-settings' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'cupcake-settings' }, xray = $XRAY_BLUR })

hl.window_rule({ match = { class = 'quickshell' }, opacity = '1.0 1.0' })
hl.window_rule({ match = { class = 'quickshell' }, no_blur = false })
EOF
else
    cat <<EOF >> ~/.config/hypr/transparency.lua
hl.window_rule({ match = { class = 'quickshell' }, no_blur = true })
hl.window_rule({ match = { title = 'Cupcake Settings' }, no_blur = true })
EOF
fi

killall -SIGUSR1 kitty 2>/dev/null || true
hyprctl reload

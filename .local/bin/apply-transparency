#!/bin/bash
TRANS=$(cat ~/.config/cupcake/.transparency 2>/dev/null)
BAR_TRANS=$(cat ~/.config/cupcake/.bar_transparency 2>/dev/null)
source ~/.config/cupcake/.transparency_values 2>/dev/null

OPACITY=${OPACITY:-0.90}
BLUR_SIZE=${BLUR_SIZE:-11}
BLUR_PASSES=${BLUR_PASSES:-3}
INACTIVE_OPACITY=$OPACITY

if [ "$TRANS" = "true" ]; then
    echo "decoration {
    active_opacity = $OPACITY
    inactive_opacity = $INACTIVE_OPACITY
    blur {
        enabled = true
        size = $BLUR_SIZE
        passes = $BLUR_PASSES
    }
}" > ~/.config/hypr/transparency.conf
    sed -i "s/^background_opacity.*/background_opacity $OPACITY/g" ~/.config/kitty/kitty.conf
else
    echo "decoration {
    active_opacity = 1.0
    inactive_opacity = 1.0
    blur {
        enabled = false
    }
}" > ~/.config/hypr/transparency.conf
    sed -i 's/^background_opacity.*/background_opacity 1.0/g' ~/.config/kitty/kitty.conf
fi

if [ "$BAR_TRANS" = "true" ]; then
    echo "layerrule = blur, quickshell
layerrule = ignorealpha 0.2, quickshell
layerrule = blur, quickshell:.*
layerrule = ignorealpha 0.2, quickshell:.*
layerrule = blur, cupcake-launcher
layerrule = ignorealpha 0.2, cupcake-launcher
layerrule = blur, cupcake-wallpaper
layerrule = ignorealpha 0.2, cupcake-wallpaper
layerrule = blur, waybar
layerrule = ignorealpha 0.2, waybar
windowrulev2 = opaque, class:^(kitty)$
windowrulev2 = opaque, class:^(quickshell)$" >> ~/.config/hypr/transparency.conf
else
    echo "windowrulev2 = noblur, class:^(quickshell)$
windowrulev2 = noblur, title:^(Cupcake Settings)$" >> ~/.config/hypr/transparency.conf
fi

killall -SIGUSR1 kitty 2>/dev/null || true
hyprctl reload

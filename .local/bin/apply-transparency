#!/bin/bash
TRANS=$(cat ~/.config/cupcake/.transparency 2>/dev/null)
source ~/.config/cupcake/.transparency_values 2>/dev/null

# Default values if missing
OPACITY=${OPACITY:-0.90}
BLUR_SIZE=${BLUR_SIZE:-6}
BLUR_PASSES=${BLUR_PASSES:-3}

# Calculate inactive opacity slightly lower than active
INACTIVE_OPACITY=$(awk "BEGIN {print $OPACITY - 0.05}")
if (( $(echo "$INACTIVE_OPACITY < 0.1" | bc -l) )); then INACTIVE_OPACITY=0.1; fi

if [ "$TRANS" = "true" ]; then
    echo "hl.config({
    decoration = {
        active_opacity = $OPACITY,
        inactive_opacity = $INACTIVE_OPACITY,
        blur = {
            size = $BLUR_SIZE,
            passes = $BLUR_PASSES
        }
    }
})
hl.layer_rule({ match = { namespace = 'quickshell' }, blur = true, ignore_alpha = 0.2 })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, blur = true, ignore_alpha = 0.2 })
hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, blur = true, ignore_alpha = 0.2 })
hl.layer_rule({ match = { namespace = 'waybar' }, blur = true, ignore_alpha = 0.2 })
hl.window_rule({ match = { class = '.*' }, opacity = '$OPACITY $INACTIVE_OPACITY', no_blur = false })
" > ~/.config/hypr/transparency.lua
    sed -i "s/^background_opacity.*/background_opacity $OPACITY/g" ~/.config/kitty/kitty.conf
else
    echo "hl.config({
    decoration = {
        active_opacity = 1.0,
        inactive_opacity = 1.0
    }
})
hl.layer_rule({ match = { namespace = 'quickshell' }, blur = false })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, blur = false })
hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, blur = false })
hl.layer_rule({ match = { namespace = 'waybar' }, blur = false })
hl.window_rule({ match = { class = '.*' }, opacity = '1.0 1.0' })
" > ~/.config/hypr/transparency.lua
    sed -i 's/^background_opacity.*/background_opacity 1.0/g' ~/.config/kitty/kitty.conf
fi

killall -SIGUSR1 kitty 2>/dev/null || true
hyprctl reload

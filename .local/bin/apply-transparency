#!/bin/bash
TRANS=$(cat ~/.config/cupcake/.transparency 2>/dev/null)
BAR_TRANS=$(cat ~/.config/cupcake/.bar_transparency 2>/dev/null)
source ~/.config/cupcake/.transparency_values 2>/dev/null

OPACITY=${OPACITY:-0.90}
BLUR_SIZE=${BLUR_SIZE:-11}
BLUR_PASSES=${BLUR_PASSES:-3}
INACTIVE_OPACITY=$OPACITY

XRAY_BLUR=$(cat ~/.config/cupcake/.xray_blur 2>/dev/null || echo true)
[ -z "$XRAY_BLUR" ] && XRAY_BLUR=true

if [ "$TRANS" = "true" ]; then
    cat <<EOF > ~/.config/hypr/transparency.lua
hl.config({
    decoration = {
        active_opacity = $OPACITY,
        inactive_opacity = $INACTIVE_OPACITY,
        blur = {
            enabled = true,
            size = $BLUR_SIZE,
            passes = $BLUR_PASSES,
            xray = $XRAY_BLUR,
            popups = false,
            ignore_opacity = true
        }
    }
})
EOF
    sed -i "s/^background_opacity.*/background_opacity $OPACITY/g" ~/.config/kitty/kitty.conf
else
    cat <<EOF > ~/.config/hypr/transparency.lua
hl.config({
    decoration = {
        active_opacity = 1.0,
        inactive_opacity = 1.0,
        blur = {
            enabled = false
        }
    }
})
EOF
    sed -i 's/^background_opacity.*/background_opacity 1.0/g' ~/.config/kitty/kitty.conf
fi

if [ "$BAR_TRANS" = "true" ]; then
    # Calculate the minimum opacity across all widgets to set the optimal ignore_alpha threshold
    BAR_OP=$(cat ~/.config/cupcake/.bar_opacity 2>/dev/null || echo 1.0)
    SOLID_BAR_OP=$(cat ~/.config/cupcake/.solid_bar_opacity 2>/dev/null || echo 1.0)
    DOCK_OP=$(cat ~/.config/cupcake/.dock_opacity 2>/dev/null || echo 1.0)
    CC_OP=$(cat ~/.config/cupcake/.cc_opacity 2>/dev/null || echo 1.0)
    NOTIF_OP=$(cat ~/.config/cupcake/.notif_panel_opacity 2>/dev/null || echo 1.0)
    
    [ -z "$BAR_OP" ] && BAR_OP=1.0
    [ -z "$SOLID_BAR_OP" ] && SOLID_BAR_OP=1.0
    [ -z "$DOCK_OP" ] && DOCK_OP=1.0
    [ -z "$CC_OP" ] && CC_OP=1.0
    [ -z "$NOTIF_OP" ] && NOTIF_OP=1.0
    
    MIN_OP=$(echo -e "$BAR_OP\n$SOLID_BAR_OP\n$DOCK_OP\n$CC_OP\n$NOTIF_OP" | sort -n | head -n 1)
    
    # Subtract 0.05 from the lowest opacity to allow the main body to blur, 
    # but block the soft anti-aliased edges from blurring (prevents the square bleed halo)
    IGNORE_ALPHA=$(echo "$MIN_OP - 0.05" | bc)
    if (( $(echo "$IGNORE_ALPHA <= 0.0" | bc -l) )); then
        IGNORE_ALPHA="0.01"
    fi

    if (( $(echo "$IGNORE_ALPHA <= 0.0" | bc -l) )); then
        IGNORE_ALPHA="0.01"
    fi

    cat <<EOF >> ~/.config/hypr/transparency.lua
hl.layer_rule({ match = { namespace = 'quickshell' }, blur = true })
hl.layer_rule({ match = { namespace = 'quickshell' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'quickshell' }, xray = $XRAY_BLUR })

hl.layer_rule({ match = { namespace = 'quickshell:.*' }, blur = true })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, xray = $XRAY_BLUR })
hl.layer_rule({ match = { namespace = 'quickshell:.*' }, blur_popups = true })

hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, blur = true })
hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'cupcake-launcher' }, xray = $XRAY_BLUR })

hl.layer_rule({ match = { namespace = 'cupcake-wallpaper' }, blur = true })
hl.layer_rule({ match = { namespace = 'cupcake-wallpaper' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'cupcake-wallpaper' }, xray = $XRAY_BLUR })

hl.layer_rule({ match = { namespace = 'cupcake-settings' }, blur = true })
hl.layer_rule({ match = { namespace = 'cupcake-settings' }, ignore_alpha = $IGNORE_ALPHA })
hl.layer_rule({ match = { namespace = 'cupcake-settings' }, xray = $XRAY_BLUR })

hl.window_rule({ match = { class = 'quickshell' }, opacity = '1.0 1.0' })
hl.window_rule({ match = { class = 'quickshell' }, no_blur = false })
EOF
else
    cat <<EOF >> ~/.config/hypr/transparency.lua
hl.window_rule({ match = { class = 'quickshell' }, no_blur = true })
hl.window_rule({ match = { title = 'Cupcake Settings' }, no_blur = true })
EOF
fi

killall -SIGUSR1 kitty 2>/dev/null || true
hyprctl reload

#!/bin/bash

if [ -z "$1" ]; then
    if [ -f ~/.cache/current_wallpaper ]; then
        WALLPAPER=$(cat ~/.cache/current_wallpaper)
    else
        echo "Usage: $0 <path-to-wallpaper>"
        exit 1
    fi
else
    WALLPAPER="$1"
    echo "$WALLPAPER" > ~/.cache/current_wallpaper
fi

if [ ! -f "$WALLPAPER" ]; then
    echo "Error: File not found: $WALLPAPER"
    exit 1
fi

export PATH=$PATH:/home/zero/.local/bin:/home/zero/.cargo/bin

MODE="dark"
if [ -f ~/.config/cupcake/.color_mode ]; then
    MODE=$(cat ~/.config/cupcake/.color_mode)
fi

# Run matugen to generate themes
echo "Generating color palettes with matugen in $MODE mode..."
/home/zero/.local/bin/matugen image "$WALLPAPER" -m "$MODE" --source-color-index 0

# Set GNOME color-scheme so GTK applications natively follow the light/dark mode toggle
if [ "$MODE" = "light" ]; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
else
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
fi

# Set the wallpaper with awww
echo "Setting wallpaper..."
if pgrep -x "awww-daemon" > /dev/null || pgrep -x "swww-daemon" > /dev/null; then
    awww img "$WALLPAPER" --transition-type grow --transition-fps 60 --transition-duration 1
else
    awww-daemon &
    sleep 1
    awww img "$WALLPAPER" --transition-type grow --transition-fps 60 --transition-duration 1
fi

# Reload hyprland to pick up colors.conf (assuming you add 'source = ~/.config/hypr/colors.conf' to hyprland.conf)
echo "Reloading Hyprland..."
hyprctl reload

# Send SIGUSR1 to kitty processes to reload config
echo "Reloading Kitty..."
touch ~/.config/kitty/kitty.conf
killall -SIGUSR1 kitty 2>/dev/null || true

# Restart Quickshell to pick up the new Theme.qml
# We run this in the background detached so the script doesn't kill itself
echo "Reloading Quickshell..."
nohup bash -c 'sleep 0.5; killall -9 quickshell; sleep 0.5; rm -rf ~/.cache/quickshell/*cache* ~/.cache/QtProject/"Qml Runtime"; QT_NO_SESSION_MANAGER=1 quickshell -p ~/.config/quickshell/shell.qml & quickshell --daemonize -p ~/.config/quickshell/WallpaperSwitcher.qml' >/dev/null 2>&1 &
disown

echo "Theme applied successfully!"

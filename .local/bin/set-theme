#!/bin/bash

if [ -z "$1" ]; then
    if [ -f ~/.cache/current_wallpaper ]; then
        WALLPAPER=$(cat ~/.cache/current_wallpaper)
    else
        echo "Usage: $0 <path-to-wallpaper>"
        exit 1
    fi
else
    WALLPAPER="$1"
    echo "$WALLPAPER" > ~/.cache/current_wallpaper
fi

echo "run: $WALLPAPER at $(date)" >> /tmp/wallpaper.log

if [ ! -f "$WALLPAPER" ]; then
    echo "Warning: Wallpaper file not found: $WALLPAPER. Searching for fallback..."
    FALLBACK_WALL=$(find "$HOME/.config/cupcake/walls" -maxdepth 2 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.webp" \) 2>/dev/null | head -n 1)
    if [ -n "$FALLBACK_WALL" ] && [ -f "$FALLBACK_WALL" ]; then
        WALLPAPER="$FALLBACK_WALL"
        echo "$WALLPAPER" > ~/.cache/current_wallpaper
        echo "Using fallback wallpaper: $WALLPAPER"
    else
        echo "Error: File not found: $WALLPAPER and no fallback wallpapers in ~/.config/cupcake/walls"
        exit 1
    fi
fi

export PATH=$PATH:$HOME/.local/bin:$HOME/.cargo/bin

MODE="dark"
if [ -f ~/.config/cupcake/.color_mode ]; then
    MODE=$(cat ~/.config/cupcake/.color_mode)
fi

# Read Color Scheme Preset
SCHEME="tonal-spot"
if [ -f ~/.config/cupcake/.color_scheme ]; then
    SCHEME_RAW=$(cat ~/.config/cupcake/.color_scheme)
    SCHEME=$(echo "$SCHEME_RAW" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
fi

# Validate matugen scheme type against supported Material 3 schemes
case "$SCHEME" in
    content|expressive|fidelity|fruit-salad|monochrome|neutral|rainbow|tonal-spot|vibrant)
        ;;
    *)
        SCHEME="tonal-spot"
        ;;
esac

# Read Icon and Cursor Theme
ICON_THEME_DARK="Papirus-Dark"
ICON_THEME_LIGHT="Papirus-Light"
CURSOR_THEME="Bibata-Modern-Ice"

if [ -f ~/.config/cupcake/.icon_theme ]; then
    USER_ICON=$(cat ~/.config/cupcake/.icon_theme)
    ICON_THEME_DARK="$USER_ICON"
    ICON_THEME_LIGHT="$USER_ICON"
fi

if [ -f ~/.config/cupcake/.cursor_theme ]; then
    CURSOR_THEME=$(cat ~/.config/cupcake/.cursor_theme)
fi

# Set the wallpaper with awww immediately (no delay needed)
TRANSITION="${2:-wipe}"
echo "Setting wallpaper with transition: $TRANSITION..."
awww img "$WALLPAPER" --transition-type "$TRANSITION" --transition-fps 60 --transition-duration 1.5 &

# Run matugen to generate themes
# Ensure target directories for templates exist
mkdir -p ~/.local/state/quickshell/user/generated ~/.cache ~/.config/gtk-3.0 ~/.config/gtk-4.0 ~/.config/kitty ~/.config/hypr

# Use ffmpeg to downscale to 400x400 for fast color extraction
echo "Generating color palettes with matugen in $MODE mode using scheme-$SCHEME..."
if command -v ffmpeg &>/dev/null; then
    ffmpeg -y -i "$WALLPAPER" -vf scale=400:400 -update 1 -frames:v 1 /tmp/matugen_input.png 2>/dev/null \
        || cp "$WALLPAPER" /tmp/matugen_input.png
else
    cp "$WALLPAPER" /tmp/matugen_input.png
fi
matugen image "$WALLPAPER" -m "$MODE" -t "scheme-$SCHEME" --source-color-index 0

# Apply KDE colors dynamically
~/.config/matugen/templates/kde/kde-material-you-colors-wrapper.sh --scheme-variant "scheme-$SCHEME" || true

# Send SIGUSR1 to kitty processes to reload config
echo "Reloading Kitty..."
touch ~/.config/kitty/kitty.conf
killall -SIGUSR1 kitty 2>/dev/null || true

# Reload Hyprland; Quickshell theme updates automatically via FileView watchers
echo "Reloading Hyprland and Quickshell..."
hyprctl reload
~/.local/bin/apply-borders

# Run slow GTK and Icon updates in the background so they don't block
(
    # Set GNOME color-scheme so GTK applications natively follow the light/dark mode toggle
    if [ "$MODE" = "light" ]; then
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
        gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME_LIGHT"
        gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR_THEME"
        gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3'
        sed -i "s/gtk-icon-theme-name=.*/gtk-icon-theme-name=$ICON_THEME_LIGHT/g" ~/.config/gtk-3.0/settings.ini
        sed -i "s/gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$CURSOR_THEME/g" ~/.config/gtk-3.0/settings.ini || echo "gtk-cursor-theme-name=$CURSOR_THEME" >> ~/.config/gtk-3.0/settings.ini
        sed -i 's/gtk-theme-name=.*/gtk-theme-name=adw-gtk3/g' ~/.config/gtk-3.0/settings.ini
    else
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
        gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME_DARK"
        gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR_THEME"
        gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
        sed -i "s/gtk-icon-theme-name=.*/gtk-icon-theme-name=$ICON_THEME_DARK/g" ~/.config/gtk-3.0/settings.ini
        sed -i "s/gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$CURSOR_THEME/g" ~/.config/gtk-3.0/settings.ini || echo "gtk-cursor-theme-name=$CURSOR_THEME" >> ~/.config/gtk-3.0/settings.ini
        sed -i 's/gtk-theme-name=.*/gtk-theme-name=adw-gtk3-dark/g' ~/.config/gtk-3.0/settings.ini
    fi

    # Update Papirus folders color based on the new Matugen palette
    echo "Updating dynamic icon colors..."
    # Run with /dev/null to prevent sudo from hanging if it prompts for password
    "$HOME/.local/bin/dynamic-icons" < /dev/null > /dev/null 2>&1 || true

    # Force Nautilus to restart so it picks up the new cached icons
    killall -q nautilus || true
) & disown

echo "Theme applied successfully!"
